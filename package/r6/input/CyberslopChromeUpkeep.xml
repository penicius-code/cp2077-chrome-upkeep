<?xml version="1.0"?>
<!-- Cyberslop Chrome Upkeep 1.3.0: Treat injuries button in the ripperdoc cyberware screen.
     Y / L3: free in UIMenu (N = ForceStun) (C = Armor Up repair, P = FilthyAccessPoints repair). -->
<bindings>
    <context name="CyberslopClinic" >
        <action name="cyberslop_treat_injuries" map="cyberslop_treat_injuries" />
    </context>

    <context name="UIMenu" append="true">
        <include name="CyberslopClinic" />
    </context>

    <mapping name="cyberslop_treat_injuries" type="Button" >
        <button id="IK_Y" />
        <button id="IK_Pad_LeftThumb" />
    </mapping>
</bindings>
